# ── Session ────────────────────────────────────────────────────────────────
# Secret used to sign session cookies (local auth). Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database ───────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PGlite database in ./.data
# (same SQL migrations, pgvector and Row Level Security as Supabase).
# To use Supabase Postgres, set the pooled connection string:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ── Auth ───────────────────────────────────────────────────────────────────
# "local" (default): email/password stored in auth.users of the local database.
# "supabase": Supabase Auth (GoTrue). Requires the two variables below.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── AI ─────────────────────────────────────────────────────────────────────
# Without a key the app uses the built-in heuristic provider (works offline).
# With a key, recipe extraction (text, screenshots, messy web pages) and
# feedback interpretation use Claude, validated with Zod.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
